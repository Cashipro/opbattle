# ============================================
# 🚀 OPBATTLE BACKEND ENVIRONMENT VARIABLES
# ============================================

# -------------------- App --------------------
NODE_ENV=development
PORT=3000

# -------------------- Database --------------------
# Neon PostgreSQL Connection String
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/opbattle?sslmode=require

# -------------------- JWT Authentication --------------------
# Generate a strong secret (min 32 characters)
# Use: openssl rand -base64 32
JWT_SECRET=your_super_secret_key_min_32_characters_here
JWT_EXPIRATION=24h

# -------------------- CORS --------------------
# Frontend URL (Vercel)
FRONTEND_URL=http://localhost:3001

# -------------------- Admin --------------------
# Default admin account (change on first login)
ADMIN_EMAIL=admin@opbattle.com
ADMIN_PASSWORD=SecureAdmin123!

# -------------------- Email (Optional) --------------------
# SMTP settings for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# -------------------- Storage (Optional) --------------------
# Cloudflare R2
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
R2_BUCKET_NAME=opbattle

# -------------------- Payment Gateways (Optional) --------------------
STRIPE_SECRET_KEY=sk_test_xxx
JAZZCASH_MERCHANT_ID=xxx
JAZZCASH_PASSWORD=xxx
BKASH_API_KEY=xxx
