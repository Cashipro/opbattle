model TournamentTeam {


id String @id @default(uuid())


tournament_id String


team_number Int


team_name String?



created_at DateTime @default(now())



slots TournamentSlot[]



}



model TournamentSlot {


id String @id @default(uuid())


tournament_id String


team_id String


slot_number Int



user_id String?



joined_at DateTime?



team TournamentTeam @relation(
fields:[team_id],
references:[id]
)



user User? @relation(
fields:[user_id],
references:[id]
)



}
