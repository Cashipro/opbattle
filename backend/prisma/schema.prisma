model TournamentRound {


id String @id @default(uuid())


tournament_id String


round_number Int


name String



created_at DateTime @default(now())



tournament Tournament @relation(

fields:[tournament_id],

references:[id]

)



matches TournamentMatch[]



}




model TournamentMatch {


id String @id @default(uuid())


tournament_id String


round_id String


match_number Int


status String @default("pending")



room_id String?



room_password String?



created_at DateTime @default(now())



round TournamentRound @relation(

fields:[round_id],

references:[id]

)



teams MatchTeam[]



results MatchResult[]



}




model MatchTeam {


id String @id @default(uuid())


match_id String


team_id String



match TournamentMatch @relation(

fields:[match_id],

references:[id]

)



team TournamentTeam @relation(

fields:[team_id],

references:[id]

)



}






model MatchResult {


id String @id @default(uuid())


match_id String


team_id String


kills Int @default(0)


position Int @default(0)


points Int @default(0)



match TournamentMatch @relation(

fields:[match_id],

references:[id]

)



}
