model TournamentTeam {


id String @id @default(uuid())


tournament_id String


team_number Int


name String



slots TeamSlot[]


matches MatchTeam[]



}




model TeamSlot {


id String @id @default(uuid())


team_id String


slot_number Int


user_id String?



team TournamentTeam @relation(

fields:[team_id],

references:[id]

)



}
